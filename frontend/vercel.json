{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backspin-imaging-glimmer.ngrok-free.dev/api/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://backspin-imaging-glimmer.ngrok-free.dev/oauth2/:path*"
    },
    {
      "source": "/login/oauth2/:path*",
      "destination": "https://backspin-imaging-glimmer.ngrok-free.dev/login/oauth2/:path*"
    },
    {
      "source": "/((?!api/|oauth2/|login/oauth2/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "ngrok-skip-browser-warning",
          "value": "true"
        }
      ]
    }
  ]
}
